model Review {
  id           String   @id @default(cuid())
  jobId        String   @unique
  customerId   String
  technicianId String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  job        Job  @relation(fields: [jobId], references: [id])
  customer   User @relation("ReviewAuthor", fields: [customerId], references: [id])
  technician User @relation("ReviewTarget", fields: [technicianId], references: [id])

  @@index([technicianId, createdAt])
  @@index([technicianId, rating])
}
